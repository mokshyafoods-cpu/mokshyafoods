MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/database
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRY=7d

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

ESEWA_MERCHANT_CODE=your_esewa_merchant_code
ESEWA_SUCCESS_URL=https://yourdomain.com/payment-success
ESEWA_FAIL_URL=https://yourdomain.com/payment-fail

KHALTI_PUBLIC_KEY=your_khalti_public_key
KHALTI_SECRET_KEY=your_khalti_secret_key

FONEPAY_MERCHANT_ID=your_fonepay_merchant_id

FRONTEND_URL=https://yourdomain.com
FRONTEND_URLS=https://yourdomain.com,https://www.yourdomain.com
EMAIL_SERVICE=resend
EMAIL_API_KEY=your_email_service_api_key
EMAIL_FROM=no-reply@yourdomain.com
EMAIL_FROM_NAME=Your Company Name
ADMIN_EMAIL=admin@yourdomain.com
REPLY_TO=support@yourdomain.com

GOOGLE_CLIENT_ID=your_google_oauth_client_id

NODE_ENV=development
PORT=5000
